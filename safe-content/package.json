{
  "name": "@immediately-run/safe-content",
  "version": "0.1.1",
  "description": "The immediately.run safe renderer: non-executable MDX/Markdown as data, with no evaluator anywhere in the pipeline (TRUST_MODES_SPEC \u00a75.1). Extracted from @immediately-run/sdk's safeContent tier (PLATFORM_LAYERING_SPEC \u00a74, R3-279); the SDK re-exports it, so no import path changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/immediately-run-sdk.git",
    "directory": "safe-content"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:e2e": "node scripts/build-safecontent-e2e.mjs && node --test test/safeContent.e2e.mjs",
    "verify": "npm run docs && npm run build && npm run test && npm run test:e2e && npm run check:llms",
    "docs": "typedoc --json docs/api.json && node scripts/gen-llms.mjs",
    "check:llms": "node scripts/gen-llms.mjs --check"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@immediately-run/mdx-plugins": "0.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "jsdom": "^25.0.0",
    "typedoc": "^0.27.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
