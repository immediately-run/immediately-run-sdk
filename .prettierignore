# Generated sources that are COMMITTED and regenerated by their generators. Formatting
# them would make `verify:codegen-parity` fail the moment a generator ran again — the
# generator emits its own layout, not Prettier's. Fix the generator's output if the
# layout matters; do not format its product behind its back.
src/version.ts
src/generated/
scripts/codegen-prototype/generated/

# Committed API/contract snapshots: byte-comparison artifacts, not source.
api-snapshot.json

# Build output and unpacked verification artifacts (also gitignored, listed so a local
# run after a build behaves the same as a clean CI run).
dist/
docs/
test/.artifacts/
.compat-sdk/
.selfhost-check/
