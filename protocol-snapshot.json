{
  "formatVersion": 1,
  "repo": "@immediately-run/sdk",
  "channels": {
    "api-catalog": {
      "kind": "push",
      "direction": "host->app",
      "poll": "request-api-catalog",
      "payload": {
        "reads": [
          "methods"
        ]
      },
      "value": {
        "array": {
          "fields": [
            {
              "name": "capability",
              "optional": false,
              "type": "string"
            },
            {
              "name": "name",
              "optional": false,
              "type": "string"
            },
            {
              "name": "paramsSchema",
              "optional": true,
              "type": "Record<string, unknown> | undefined"
            },
            {
              "name": "stream",
              "optional": true,
              "type": "boolean | undefined"
            }
          ]
        },
        "type": "ApiMethod[]"
      },
      "sites": [
        "src/catalog.ts"
      ]
    },
    "auth-state": {
      "kind": "push",
      "direction": "host->app",
      "poll": "request-auth-state",
      "payload": {
        "reads": [
          "state"
        ]
      },
      "value": {
        "fields": [
          {
            "name": "status",
            "optional": false,
            "type": "AuthStatus"
          },
          {
            "name": "user",
            "optional": false,
            "type": "SandboxUser | null"
          }
        ],
        "type": "AuthState"
      },
      "sites": [
        "src/auth.ts"
      ]
    },
    "compile": {
      "kind": "message",
      "direction": "host->app",
      "payload": {
        "type": "unknown"
      },
      "sites": [
        "src/moduleCache.tsx"
      ]
    },
    "debug-enabled": {
