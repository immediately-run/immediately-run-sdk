{
  "name": "@immediately-run/sdk",
  "version": "0.15.0",
  "description": "Runtime SDK for code executing inside an immediately.run sandbox.",
  "license": "MIT",
  "repository": "github:immediately-run/immediately-run-sdk",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsup",
    "test": "jest",
    "check:circular": "node scripts/check-circular.mjs",
    "api:check": "node scripts/check-api-stability.mjs",
    "api:update": "node scripts/check-api-stability.mjs --update",
    "docs": "typedoc",
    "prepublishOnly": "npm run check:circular && npm run build && npm run api:check"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-error-boundary": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typedoc": "^0.27.0",
    "typescript": "^5.6.0"
  }
}
