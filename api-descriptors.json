{
  "schemaVersion": 1,
  "families": [
    {
      "scheme": "spaces",
      "doc": "Space management (the space-manager app) — UI_AS_APPS_SPEC §5.2. ELEVATED: enumerating all the user's spaces is `spaces:user`; mutating membership and resolving handles is `spaces:admin`.",
      "types": {
        "Role": {
          "description": "A collaborator's role on a shared space: full `owner`, read-write `writer`, or read-only `reader`.",
          "schema": {
            "type": "string",
            "enum": [
              "owner",
              "writer",
              "reader"
            ]
          }
        },
        "SpaceInfo": {
          "description": "Summary of a space, as returned by {@link listSpaces}.",
          "schema": {
            "type": "object",
            "required": [
              "spaceId"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              },
              "role": {
                "$ref": "Role"
              },
              "owner": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "Member": {
          "description": "A member of a space (for the share/manage UI).",
          "schema": {
            "type": "object",
            "required": [
              "grantee",
              "principal",
              "role"
            ],
            "properties": {
              "grantee": {
                "type": "string",
                "description": "The **grantee** — `user:{uid}` | `group:{gid}`. This is the canonical name (core_concepts §4: \"principal\" is reserved for the authority context; a space member is a *grantee*). The host populates this on every member row."
              },
              "principal": {
                "type": "string",
                "description": "@deprecated Use {@link Member.grantee}. Kept as an alias (same value) for back-compat during the `principal`→`grantee` migration; will be removed in a future major. The host still populates both."
              },
              "role": {
                "$ref": "Role"
              },
              "login": {
                "type": "string"
              },
              "avatarUrl": {
                "type": "string"
              }
            }
          }
        },
        "ResolvedUser": {
          "description": "A handle resolved to a principal (handle → who).",
          "schema": {
            "type": "object",
            "required": [
              "uid",
              "login"
            ],
            "properties": {
              "uid": {
                "type": "string"
              },
              "login": {
                "type": "string"
              },
              "avatarUrl": {
                "type": "string"
              }
            }
          }
        },
        "GrantRecord": {
          "description": "One durable grant an app holds, for the §8.11 capability audit view.",
          "schema": {
            "type": "object",
            "required": [
              "appKey",
              "spaceId",
              "mountId",
              "mode"
            ],
            "properties": {
              "appKey": {
                "type": "string",
                "description": "The app's provider-qualified **program** identity (AA-01 `appKey`). The DEFAULT program keys to the bare `provider__namespace__repository`; a NAMED mini-app appends a fourth `enc()`-escaped component (`provider__namespace__repository__name`) so its grants isolate from the repo's other programs. Host-supplied — the app never builds this key."
              },
              "spaceId": {
                "type": "string"
              },
              "mountId": {
                "type": "string",
                "description": "Universal mount id (§3.5)."
              },
              "subtree": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "ro",
                  "rw"
                ]
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "Invite": {
          "description": "A pending invitation to a space (pull-based sharing, FILE_SHARING_SPEC §6.4). It grants NO access until accepted — the recipient accepts it from their inbox ({@link listMyInvites} → {@link acceptInvite}), materializing membership. The display fields (`name`/`login`/`avatarUrl`) are untrusted for rendering.",
          "schema": {
            "type": "object",
            "required": [
              "spaceId",
              "uid",
              "role",
              "owner",
              "invitedBy"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              },
              "uid": {
                "type": "string",
                "description": "The invitee's uid — carried so the owner's pending list can {@link revokeInvite}(spaceId, uid)."
              },
              "role": {
                "$ref": "Role"
              },
              "owner": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "invitedBy": {
                "type": "string"
              },
              "invitedAt": {
                "type": "number",
                "description": "epoch ms (server-stamped); absent until the write settles."
              },
              "login": {
                "type": "string"
              },
              "avatarUrl": {
                "type": "string"
              }
            }
          }
        }
      },
      "methods": [
        {
          "name": "spaces:list",
          "capability": "spaces:app",
          "kind": "request",
          "params": {
            "type": "object",
            "properties": {
              "app": {
                "type": "boolean",
                "description": "Only spaces bound to this app."
              }
            }
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "SpaceInfo"
            }
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "List spaces you can access — all of them, or just those bound to this app.",
          "alias": {
            "fn": "listSpaces",
            "positional": [
              "opts"
            ]
          }
        },
        {
          "name": "spaces:listAll",
          "capability": "spaces:user",
          "kind": "request",
          "params": {
            "type": "object",
            "properties": {}
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "SpaceInfo"
            }
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Enumerate ALL the user's spaces (not just this app's).",
          "alias": {
            "fn": "listAllSpaces",
            "positional": []
          }
        },
        {
          "name": "spaces:members",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "Member"
            }
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Read a space's members one-shot.",
          "alias": {
            "fn": "getSpaceMembers",
            "positional": [
              "spaceId"
            ]
          }
        },
        {
          "name": "spaces:invite",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId",
              "login",
              "role"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              },
              "login": {
                "type": "string"
              },
              "role": {
                "$ref": "Role"
              }
            }
          },
          "result": {
            "type": "void"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown",
            "quota-exceeded"
          ],
          "doc": "Invite a user (by provider handle) to a space at a role. The host resolves the handle, so the app never sees other users' uids except the one it invited. Pull-based (FILE_SHARING_SPEC §6.4): this writes an INVITATION, not membership — the recipient must {@link acceptInvite}. Re-inviting an already-invited/member user is idempotent.",
          "alias": {
            "fn": "inviteToSpace",
            "positional": [
              "spaceId",
              "login",
              "role"
            ]
          }
        },
        {
          "name": "spaces:unshare",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId",
              "uid"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              },
              "uid": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "void"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown",
            "conflict"
          ],
          "doc": "Remove a member from a space. Refused if it would orphan the space (owner-lockout, T41).",
          "alias": {
            "fn": "unshareSpace",
            "positional": [
              "spaceId",
              "uid"
            ]
          }
        },
        {
          "name": "spaces:setRole",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId",
              "uid",
              "role"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              },
              "uid": {
                "type": "string"
              },
              "role": {
                "$ref": "Role"
              }
            }
          },
          "result": {
            "type": "void"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown",
            "conflict"
          ],
          "doc": "Change a member's role. Refused if it would drop the sole owner (owner-lockout, T41).",
          "alias": {
            "fn": "setSpaceRole",
            "positional": [
              "spaceId",
              "uid",
              "role"
            ]
          }
        },
        {
          "name": "spaces:lookupUser",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "login"
            ],
            "properties": {
              "login": {
                "type": "string"
              }
            }
          },
          "result": {
            "$ref": "ResolvedUser"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Resolve a provider handle to a principal (for the invite flow). Rate-limited host-side.",
          "alias": {
            "fn": "lookupUser",
            "positional": [
              "login"
            ]
          }
        },
        {
          "name": "spaces:grants",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "properties": {}
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "GrantRecord"
            }
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Enumerate every (app, mount) grant the user holds — the audit view (§8.11). Elevated.",
          "alias": {
            "fn": "listGrants",
            "positional": []
          }
        },
        {
          "name": "spaces:revokeGrant",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "appKey",
              "spaceId"
            ],
            "properties": {
              "appKey": {
                "type": "string"
              },
              "spaceId": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "void"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Revoke one app's grant on a space — durable (the app can't re-mount) plus a best-effort live teardown. Elevated.",
          "alias": {
            "fn": "revokeGrant",
            "positional": [
              "appKey",
              "spaceId"
            ]
          }
        },
        {
          "name": "spaces:pendingInvites",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "Invite"
            }
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "The owner's outstanding invitations for a space.",
          "alias": {
            "fn": "listPendingInvites",
            "positional": [
              "spaceId"
            ]
          }
        },
        {
          "name": "spaces:revokeInvite",
          "capability": "spaces:admin",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId",
              "uid"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              },
              "uid": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "void"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Withdraw a pending invitation (distinct from {@link unshareSpace}, which removes an ACCEPTED member).",
          "alias": {
            "fn": "revokeInvite",
            "positional": [
              "spaceId",
              "uid"
            ]
          }
        },
        {
          "name": "spaces:listInvites",
          "capability": "spaces:user",
          "kind": "request",
          "params": {
            "type": "object",
            "properties": {}
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "Invite"
            }
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "The caller's OWN invitation inbox.",
          "alias": {
            "fn": "listMyInvites",
            "positional": []
          }
        },
        {
          "name": "spaces:acceptInvite",
          "capability": "spaces:user",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "void"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Accept an invitation: materialize your membership at the invited role and clear the invite. An invitation the caller doesn't hold rejects with `forbidden` (indistinguishable from a nonexistent space; no existence oracle).",
          "alias": {
            "fn": "acceptInvite",
            "positional": [
              "spaceId"
            ]
          }
        },
        {
          "name": "spaces:declineInvite",
          "capability": "spaces:user",
          "kind": "request",
          "params": {
            "type": "object",
            "required": [
              "spaceId"
            ],
            "properties": {
              "spaceId": {
                "type": "string"
              }
            }
          },
          "result": {
            "type": "void"
          },
          "errors": [
            "auth-required",
            "cancelled",
            "forbidden",
            "not-found",
            "unsupported-scheme",
            "unknown"
          ],
          "doc": "Decline (dismiss) an invitation from your inbox; writes no membership.",
          "alias": {
            "fn": "declineInvite",
            "positional": [
              "spaceId"
            ]
          }
        }
      ]
    },
    {
      "scheme": "streams",
      "doc": "Streaming host methods — contribute (UI_AS_APPS §5.1) and llm:chat (LLM_AND_AGENTS_SPEC §8 D5; the SERVICE_PROVIDERS spec is retired, R3-166 §not-in-scope).",
      "types": {
        "ContributeMode": {
          "description": "The save strategy. `direct` requires the first-party `contribute:direct` capability.",
          "schema": {
            "type": "string",
            "enum": [
              "pr",
              "direct"
            ]
          }
        },
        "ContributionResult": {
          "description": "The settled outcome (the stream’s return value).",
          "schema": {
            "type": "object",
            "required": [
              "commitSha",
              "treeSha",
              "branchName",
              "mode"
            ],
            "properties": {
              "prUrl": {
                "type": "string"
              },
              "prNumber": {
                "type": "number"
              },
              "commitSha": {
                "type": "string"
              },
              "treeSha": {
                "type": "string"
              },
              "branchName": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "direct-commit",
                  "new-branch-pr",
                  "extend-existing"
                ]
              }
            }
          }
        },
        "ContributionEvent": {
          "description": "A stage emitted as the contribution runs (progress only — never token or blobs).",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "auth-check"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "diff-compute"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "permission-check"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "targetOwner",
                  "targetRepo",
                  "installUrl"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "install-required"
                  },
                  "targetOwner": {
                    "type": "string"
                  },
                  "targetRepo": {
                    "type": "string"
                  },
                  "installUrl": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "conflict-check"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "forkOwner",
                  "alreadyExists"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "fork-prepare"
                  },
                  "forkOwner": {
                    "type": "string"
                  },
                  "alreadyExists": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "path",
                  "index",
                  "total"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "upload-blob"
                  },
                  "path": {
                    "type": "string"
                  },
                  "index": {
                    "type": "number"
                  },
                  "total": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "create-tree"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "create-commit"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "branchName"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "create-branch"
                  },
                  "branchName": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "create-pr"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "prNumber",
                  "prUrl",
                  "commitSha"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "pr-updated"
                  },
                  "prNumber": {
                    "type": "number"
                  },
                  "prUrl": {
                    "type": "string"
                  },
                  "commitSha": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "ref",
                  "commitSha"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "commit-pushed"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "commitSha": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "commitSha"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "done"
                  },
                  "commitSha": {
                    "type": "string"
                  },
                  "prUrl": {
                    "type": "string"
                  },
                  "prNumber": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stage",
                  "message",
                  "recoverable"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "const": "error"
                  },
                  "message": {
                    "type": "string"
                  },
                  "recoverable": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "ChatRole": {
          "description": "Who authored a message.",
          "schema": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          }
        },
        "ContentPart": {
          "description": "A part of a message.",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "mimeType",
                  "data"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "data": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "ChatMessage": {
          "description": "One message in a ChatRequest.",
          "schema": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "$ref": "ChatRole"
              },
              "content": {
                "type": "array",
                "items": {
                  "$ref": "ContentPart"
                }
              }
            }
          }
        },
        "ToolDef": {
          "description": "A tool the model may call — honored only when `features.tools`.",
          "schema": {
            "type": "object",
            "required": [
              "name",
              "inputSchema"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "__opt": true
              },
              "inputSchema": {
                "type": "record"
              }
            }
          }
        },
        "ChatDelta": {
          "description": "One streamed chunk.",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "text-delta"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "id",
                  "name",
                  "input"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "tool-call"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "input": {
                    "type": "unknown"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "inputTokens",
                  "outputTokens"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "usage"
                  },
                  "inputTokens": {
                    "type": "number"
                  },
                  "outputTokens": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        },
        "ChatResult": {
          "description": "The terminal value of the chat stream.",
          "schema": {
            "type": "object",
            "required": [
              "stopReason"
            ],
            "properties": {
              "stopReason": {
                "type": "string",
                "enum": [
                  "end",
                  "length",
                  "tool",
                  "filtered"
                ]
              }
            }
          }
        }
      },
      "methods": [
        {
          "name": "contribute:run",
          "capability": "contribute:any",
          "kind": "stream",
          "params": {
            "type": "object",
            "required": [
              "commitMessage"
            ],
            "properties": {
              "commitMessage": {
                "type": "string"
              },
              "mode": {
                "$ref": "ContributeMode"
              },
              "branchName": {
                "type": "string"
              }
            }
          },
          "result": {
            "$ref": "ContributionResult"
          },
          "event": {
            "$ref": "ContributionEvent"
          },
          "errors": [
            "forbidden",
            "auth-required",
            "invalid",
            "unknown"
          ],
          "doc": "Save the current working tree, streaming each stage. Yields ContributionEvents and returns a ContributionResult. mode \"direct\" needs the `contribute:direct` capability (a `contribute:any` app asking for it is rejected `forbidden`, T11).",
          "alias": {
            "fn": "contribute"
          }
        },
        {
          "name": "llm:chat",
          "capability": "llm:chat",
          "kind": "stream",
          "params": {
            "type": "object",
            "required": [
              "messages"
            ],
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "ChatMessage"
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "$ref": "ToolDef"
                }
              },
              "responseFormat": {
                "type": "string",
                "enum": [
                  "text",
                  "json"
                ]
              },
              "maxTokens": {
                "type": "number"
              },
              "modelHint": {
                "type": "string",
                "enum": [
                  "fast",
                  "smart"
                ]
              }
            }
          },
          "result": {
            "$ref": "ChatResult"
          },
          "event": {
            "$ref": "ChatDelta"
          },
          "errors": [
            "forbidden",
            "auth-required",
            "invalid",
            "unknown"
          ],
          "doc": "Stream a chat completion from whichever provider the user has configured. The app never names a vendor and never sees the key. No provider bound → the stream throws `auth-required` (the SP-7 connect-me prompt).",
          "alias": {
            "fn": "chat"
          }
        }
      ]
    }
  ]
}
